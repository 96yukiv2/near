# NUXT_PUBLIC_* values are sent to browsers. Use only the publishable key here.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# Optional HTTPS MapLibre style URL; empty uses the OpenStreetMap standard map.
NUXT_PUBLIC_MAP_STYLE_URL=

# Server-only values below must be configured in the deployment's secret store.
# Passkey/OIDC work is incomplete; keep both flags disabled.
NUXT_NEAR_AUTH_ENABLED=false
NUXT_PUBLIC_NEAR_PASSKEY_ENABLED=false
NUXT_NEAR_AUTH_BASE_URL=
NUXT_NEAR_AUTH_SECRET=
NUXT_NEAR_AUTH_DATABASE_URL=
NUXT_NEAR_AUTH_DATABASE_CA=
NUXT_PUBLIC_NEAR_RECOVERY_ENABLED=false
NUXT_NEAR_AUTH_RECOVERY_ENABLED=false
NUXT_NEAR_AUTH_SMTP_URL=
NUXT_NEAR_AUTH_MAIL_FROM=
NUXT_NEAR_AUTH_SUPABASE_SECRET_KEY=
