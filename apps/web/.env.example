# Publishable key only. Never put a secret/service_role key in the web app.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# Set to true only after configuring and testing Google OAuth in Supabase.
NUXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
