{
  "name": "near",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev -w @near/web",
    "build": "npm run build -w @near/web",
    "typecheck": "npm run typecheck -w @near/web && npm run typecheck -w @near/mobile",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "auth:register-oidc-client": "node scripts/register-oidc-client.mjs",
    "dev:mobile": "npm run dev -w @near/mobile"
  },
  "devDependencies": {
    "@better-auth/oauth-provider": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "better-auth": "1.7.18",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jose": "6.2.15",
    "playwright": "1.65.0",
    "prettier": "^3.6.2",
    "supabase": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
